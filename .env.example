# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# DATABASE_URL is the APPLICATION role. It must NOT be a superuser and must NOT
# have BYPASSRLS — the server checks this at boot and refuses to start otherwise.
# Every tenant isolation guarantee in this system depends on it.
DATABASE_URL=postgresql://mizban_app:mizban_app@localhost:5432/mizban

# DATABASE_URL_ADMIN is the OWNER role. Used only by `npm run migrate` and
# `npm run seed`, which need to create policies, roles and tables.
# Never put this in the application's runtime environment.
DATABASE_URL_ADMIN=postgresql://postgres:postgres@localhost:5432/mizban

# ---------------------------------------------------------------------------
# Secrets
# ---------------------------------------------------------------------------
# Minimum 32 characters. There is deliberately no default — the server exits
# rather than sign tokens with a value that is committed anywhere.
# Generate with: openssl rand -base64 48
JWT_SECRET=
JWT_TTL=12h

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:5173

# ---------------------------------------------------------------------------
# AI provider (OPTIONAL)
# ---------------------------------------------------------------------------
# Leave blank and menu import runs heuristic-only. That is a supported mode,
# not a degraded one: the deterministic Persian parser handles most real menus
# on its own, and the app is fully functional without a key.
#
# AI_BASE_URL is any OpenAI-compatible /chat/completions endpoint. It is
# configuration rather than a constant because a deployment in Iran reaches a
# frontier model through a reseller or gateway — OpenAI and Anthropic geo-block
# Iranian IPs directly.
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_PROVIDER_NAME=
AI_TIMEOUT_MS=20000
