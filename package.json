{
  "name": "mizban",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json && npm --prefix frontend run build",
    "start": "node dist/src/server.js",
    "migrate": "tsx db/migrate.ts",
    "seed": "tsx db/seed.ts",
    "setup": "npm install && npm --prefix frontend install && docker compose up -d --wait && npm run migrate && npm run seed",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "dev:web": "npm --prefix frontend run dev",
    "migrate:prod": "node dist/db/migrate.js"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/rate-limit": "^10.2.1",
    "@fastify/static": "^8.3.0",
    "argon2": "^0.41.1",
    "dotenv": "^18.0.3",
    "fastify": "^5.1.0",
    "jalaali-js": "^2.0.1",
    "jose": "^5.9.6",
    "pg": "^8.13.1",
    "pino": "^9.5.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/pg": "^8.11.10",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5"
  }
}
